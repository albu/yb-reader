# yb-mirror config template.
#
# The yb-reader mirror reads this file on the Kindle at
# /mnt/us/extensions/mirror/mirror.conf (same path as the old plugins).
# Missing file = pure discovery, so none of this is required. Keep a copy
# on the device only when you want to pin something.
#
# Run ./sync-ip.sh from the Mac to pin SERVER= to this Mac's current
# Wi-Fi IP (and copy the file to a mounted Kindle). No IP is hardcoded
# here on purpose — the mirror writes SERVER= itself after discovery.

# Pinned Mac address — the mirror fills this in after discovery; delete
# the file (or the SERVER= line) to force a fresh discovery.
#SERVER=http://<mac-ip>:8765

# Full (flashing) anti-ghosting refresh every N frames; 0 = never.
#REFRESH_EVERY=60

# Page-turn keys for the mirror: arrows (default) | space | pages.
#TURN_KEYS=arrows

# Optional shared secret, sent as X-YB-Secret. The bundled Mac server
# requires it once a Kindle has paired (pairing also works without it).
#SECRET=
